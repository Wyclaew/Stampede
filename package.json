{
  "name": "stampede",
  "version": "2.0.0",
  "description": "Stampede: a local-first swarm of impatient users (angry customer, keyboard, mobile, attacker) that breaks web apps and turns every bug into a report and a Playwright test.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "stampede": "bin/stampede.js"
  },
  "engines": {
    "node": ">=21"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "dashboard": "node src/server/index.js",
    "demo": "node demo/server.js",
    "ghost": "node bin/stampede.js",
    "test": "node --test \"test/unit/**/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/**/*.test.js\"",
    "test:all": "npm test && npm run test:e2e",
    "postinstall": "node scripts/ensure-browser.js"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "playwright": "1.65.1"
  }
}
